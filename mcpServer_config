"mcpServers": {
"aap-mcp-job-management": {
"command": "npx",
"args": [
"-y",
"mcp-remote",
"http://aap_fqdn:3000/mcp/job_management",
"--transport",
"http-only",
"--header",
"Authorization:${AAP_AUTH_HEADER}",
"--allow-http"
],
"env": {
"AAP_AUTH_HEADER": "Bearer token"
}
},
